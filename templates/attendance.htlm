<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>Attendance Records</title>

    <link rel="stylesheet"
          href="{{ url_for('static', filename='style.css') }}">

</head>

<body>

<div class="container">

    <h1>Attendance Records</h1>


    <table>

        <tr>

            <th>Name</th>

            <th>Roll Number</th>

            <th>Date</th>

            <th>Time</th>

            <th>Status</th>

        </tr>


        {% for record in records %}

        <tr>

            <td>
                {{ record.name }}
            </td>

            <td>
                {{ record.roll_no }}
            </td>

            <td>
                {{ record.date }}
            </td>

            <td>
                {{ record.time }}
            </td>

            <td>
                {{ record.status }}
            </td>

        </tr>

        {% else %}

        <tr>

            <td colspan="5">
                No attendance records available.
            </td>

        </tr>

        {% endfor %}

    </table>


    <br>

    <a href="/">
        ← Back to Dashboard
    </a>

</div>

</body>

</html>
